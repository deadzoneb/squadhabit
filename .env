# PostgreSQL connection used by the backend container.
DATABASE_URL=postgresql://squadhabit:squadhabit@postgres:5432/squadhabit
POSTGRES_USER=squadhabit
POSTGRES_PASSWORD=squadhabit
POSTGRES_DB=squadhabit

# Backend HTTP listener inside its container.
PORT=3000
HOST=0.0.0.0

# Telegram bot credentials. BOT_TOKEN can stay empty in development.
BOT_TOKEN=
BOT_USERNAME=
STORAGE_CHAT_ID=

# Mini App URL. Use your HTTPS tunnel/public URL when testing inside Telegram.
WEBAPP_URL=http://localhost:8080

# Enables test-user auth, local photo previews, and simulated Stars purchases.
# Set to false in production.
DEV_MODE=true

# Leave empty to use the same-origin Nginx /api proxy.
VITE_API_URL=
