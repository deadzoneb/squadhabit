generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProofType {
  PHOTO
  BUTTON
}

enum ChallengeMode {
  HARDCORE
  SOFT
}

enum CheckinStatus {
  APPROVED
  VETOED
  SHIELDED
}

enum MediaType {
  NONE
  PHOTO
  VIDEO_NOTE
}

model User {
  id               String            @id @default(cuid())
  telegramId       BigInt            @unique
  username         String?
  firstName        String
  photoUrl         String?
  timezone         String            @default("UTC")
  reminderHour     Int               @default(22)
  shieldsCount     Int               @default(1)
  isPro            Boolean           @default(false)
  proUntil         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  challenges       Challenge[]       @relation("ChallengeCreator")
  memberships      ChallengeMember[]
  checkins         Checkin[]
  vetoVotes        VetoVote[]
  reactions        Reaction[]
  payments         Payment[]
  notificationLogs NotificationLog[]
}

model Challenge {
  id                String            @id @default(cuid())
  inviteCode        String            @unique
  title             String
  emoji             String
  durationDays      Int?
  proofType         ProofType
  mode              ChallengeMode
  teamStreak        Int               @default(0)
  bestTeamStreak    Int               @default(0)
  lastEvaluatedDate String?
  creatorId         String
  createdAt         DateTime          @default(now())
  creator           User              @relation("ChallengeCreator", fields: [creatorId], references: [id])
  members           ChallengeMember[]
  checkins          Checkin[]
}

model ChallengeMember {
  id             String    @id @default(cuid())
  challengeId    String
  userId         String
  personalStreak Int       @default(0)
  bestStreak     Int       @default(0)
  joinedAt       DateTime  @default(now())
  challenge      Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
}

model Checkin {
  id             String        @id @default(cuid())
  challengeId    String
  userId         String
  date           String
  status         CheckinStatus
  mediaType      MediaType
  telegramFileId String?
  caption        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  challenge      Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vetoVotes      VetoVote[]
  reactions      Reaction[]

  @@unique([challengeId, userId, date])
  @@index([challengeId, date])
  @@index([telegramFileId])
}

model VetoVote {
  id        String   @id @default(cuid())
  checkinId String
  voterId   String
  createdAt DateTime @default(now())
  checkin   Checkin  @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  voter     User     @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([checkinId, voterId])
}

model Reaction {
  id        String   @id @default(cuid())
  checkinId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  checkin   Checkin  @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([checkinId, userId, emoji])
}

model Payment {
  id                      String   @id @default(cuid())
  userId                  String
  telegramPaymentChargeId String   @unique
  productType             String
  amountXtr               Int
  createdAt               DateTime @default(now())
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  date      String
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, type])
}
